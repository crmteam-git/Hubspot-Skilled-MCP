# HubSpot Private App access token (Settings > Integrations > Private Apps)
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# Set to true to block every create/update/delete call (safe auditing mode)
HUBSPOT_READ_ONLY=false

# Optional
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_MAX_RETRIES=3
MCP_SERVER_NAME=hubspot-skilled-mcp
